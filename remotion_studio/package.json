    "render:scene03": "remotion render src/index.ts Scene03Demo ../03_Episodes/Episode_01_Kali_Puja_Birth/04_Video_Assembly/Final_Render/Scene03_Divine_Arrival_Demo.mp4 --codec=h264 --crf=18",
